# ──────────────────────────────────────────────────────────────
# 사용법: 이 파일을 복사해 .env 를 만들고 필요한 값만 주석 해제
#   Windows(PowerShell): Copy-Item .env.example .env
#   macOS/Linux:         cp .env.example .env
# ⚠️ 실제 .env 는 절대 커밋 금지 (.gitignore 에 등록되어 있음)
# ──────────────────────────────────────────────────────────────

# 테스트 대상 환경 (config/environments.py 의 키, 기본: saucedemo)
# TEST_ENV=saucedemo

# 대상 URL (미설정 시 https://www.saucedemo.com)
# BASE_URL=https://www.saucedemo.com

# saucedemo 데모 계정 — 공개 계정이라 코드에 기본값이 있음. 바꿀 때만 설정
# SAUCE_USERNAME=standard_user
# SAUCE_PASSWORD=<YOUR_PASSWORD>

# [리포트] Allure 결과 생성 (기본 꺼짐 — docs/allure-guide.md 참고)
# ALLURE=true
